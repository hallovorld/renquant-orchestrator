<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.renquant.rq104-silent-refusal-sentinel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/renhao/git/github/RenQuant/.venv/bin/python</string>
    <string>/Users/renhao/git/github/renquant-orchestrator-run/ops/renquant104/rq104_silent_refusal_sentinel.py</string>
  </array>
  <!-- Weekly, Sunday 08:11. The job it watches runs Saturday 05:30, so this
       patrols the day after each cycle: late enough that the run has finished
       and its dated log exists, early enough that a chronic refusal surfaces
       within a day rather than at the next weekly boundary. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>11</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/renhao/git/github/RenQuant/logs/rq104_silent_refusal_sentinel.log</string>
  <key>StandardErrorPath</key><string>/Users/renhao/git/github/RenQuant/logs/rq104_silent_refusal_sentinel.log</string>
</dict>
</plist>
